{
  "expo": {
    "name": "Haraka Classifieds",
    "slug": "haraka-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "haraka",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haraka.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Haraka uses the microphone to record voice descriptions for your ads and bookings.",
        "NSLocationWhenInUseUsageDescription": "Haraka uses your location to show listings and artisans in your region.",
        "NSCameraUsageDescription": "Haraka uses the camera so you can take photos of items you want to sell.",
        "NSPhotoLibraryUsageDescription": "Haraka accesses your photos so you can add pictures to your ads."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "com.haraka.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image",
        {
          "photosPermission": "The app accesses your photos to let you post item pictures."
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#FF6A00"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b2a385a4-1ac1-4a99-abd9-49adf5c794ac"
      }
    },
    "owner": "yussif112"
  }
}
