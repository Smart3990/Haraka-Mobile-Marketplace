    "dotenv": "^17.2.3",
    "expo": "^58.0.12",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.21",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "lucide-react-native": "^1.58.0",
    "motion": "^12.23.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
