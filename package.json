    "android": "expo start --android",
    "build:apk": "eas build -p android --profile preview",
    "deploy:web": "vite build && npx firebase-tools deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@google/genai": "^2.4.0",
