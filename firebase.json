{
  "firestore": [
    {
      "database": "ai-studio-38harakamobilema-f3eafe44-1483-46a5-8aac-4df68b8b4362",
      "rules": "firestore.rules"
    }
  ],
  "hosting": [
    {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/!(*.*)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "site": "harakaapp"
    },
    {
      "site": "ga4-viewer-kiyumart-platform",
      "public": "hosting-redirect",
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://harakaapp.web.app/:1",
          "type": 301
        }
      ]
    }
  ]
}
