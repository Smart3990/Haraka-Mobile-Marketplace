rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The permanent system admin (keep in sync with SYSTEM_ADMIN_EMAIL in src/lib/backend.ts)
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'blanc.69458@gmail.com';
    }

    // Signed in with a confirmed email address (needed to post, message, call, book, review or apply)
    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || isSystemAdmin());
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email);
    }

    // Admins: the system admin, or anyone added in /admins/{email} who has verified that email
    function isAdmin() {
      return isSystemAdmin() || (
        isSignedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true && exists(adminDocPath())
      );
    }

    // Who may add more admins: the system admin, or admins added with that permission
    function canAddAdmins() {
      return isSystemAdmin() || (isAdmin() && get(adminDocPath()).data.canAddAdmins == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles. New accounts are regular users ('buyer'); only an admin
    // can change someone's role or verified badge.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.role == 'buyer'
        && !('verified' in request.resource.data);
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified'])
      );
      // Users can delete their own account
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Admins added through the app, keyed by lowercase email. The system admin is never stored here.
    match /admins/{email} {
      allow get: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create, update: if canAddAdmins()
        && email != 'blanc.69458@gmail.com'
        && request.resource.data.email == email
        && request.resource.data.addedBy == request.auth.token.email
        && request.resource.data.canAddAdmins is bool;
      allow delete: if canAddAdmins();
    }

    // Partner applications (become a seller or artisan), one per user.
    // The applicant can submit or re-submit while it is pending; only an admin decides.
    match /applications/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        isOwner(userId) && isVerifiedUser()
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedBadge == false
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Marketplace listings: anyone can browse; only approved sellers/artisans post
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isVerifiedUser() && isValidId(listingId)
        && request.resource.data.sellerId == request.auth.uid
        && userRole() in ['seller', 'artisan'];
      allow update: if isSignedIn() && isValidId(listingId) && (
        (resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid)
        || isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(listingId) && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // Push tokens: any signed-in user may look one up to notify that person; only the owner sets it
    match /pushTokens/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['token', 'updatedAtISO'])
        && request.resource.data.token is string && request.resource.data.token.size() < 200;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Chats: one per buyer per ad, readable and writable only by the buyer and the ad's seller
    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isVerifiedUser() && isValidId(chatId)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.sellerId]
        && chatId == request.resource.data.listingId + '__' + request.auth.uid
        && (
          // About an artisan's services ...
          (request.resource.data.listingId == 'artisan-' + request.resource.data.sellerId
            && exists(/databases/$(database)/documents/artisans/$(request.resource.data.sellerId)))
          // ... or about an ad, with its real seller
          || get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId == request.resource.data.sellerId
        );
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAtISO', 'lastSenderId', 'unread']);

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in chatParticipants();
        allow create: if isVerifiedUser() && request.auth.uid in chatParticipants()
          && request.resource.data.senderId == request.auth.uid;
        // Only the person who received an offer can accept it
        allow update: if isSignedIn() && request.auth.uid in chatParticipants()
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus'])
          && request.resource.data.offerStatus == 'accepted';
      }
    }

    // "Report this listing": any signed-in user can send one; only admins read and handle them
    match /reports/{reportId} {
      allow create: if isVerifiedUser() && isValidId(reportId)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow get, list, update, delete: if isAdmin();
    }

    // Public artisan profiles, created by an admin when an artisan application is approved
    match /artisans/{artisanId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() || isOwner(artisanId);
      allow update: if isAdmin()
        // The artisan edits their own public details
        || (isOwner(artisanId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['available', 'inspectionFee', 'bio', 'phone', 'whatsapp', 'avatar', 'responseTime']))
        // Completing a booking adds exactly one job, once per booking
        || (isOwner(artisanId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobsCompleted', 'lastCompletedBookingId'])
          && request.resource.data.jobsCompleted == resource.data.jobsCompleted + 1
          && request.resource.data.lastCompletedBookingId != resource.data.lastCompletedBookingId
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.status != 'Completed'
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.status == 'Completed'
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.artisanId == artisanId);
    }

    // Artisan bookings: visible to the customer, the artisan and admins only
    match /bookings/{bookingId} {
      function isBookingParty() {
        return isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.artisanId == request.auth.uid ||
          isAdmin()
        );
      }
      allow get, list: if isBookingParty();
      allow create: if isVerifiedUser() && isValidId(bookingId)
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.artisanId != request.auth.uid
        && request.resource.data.status == 'Pending'
        && exists(/databases/$(database)/documents/artisans/$(request.resource.data.artisanId));
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtISO'])
        && (
          isAdmin()
          // The artisan accepts, declines, starts and completes
          || (resource.data.artisanId == request.auth.uid
            && request.resource.data.status in ['Confirmed', 'In Progress', 'Completed', 'Declined'])
          // The customer cancels (unless done) or asks again after cancelling
          || (resource.data.customerId == request.auth.uid && (
            (request.resource.data.status == 'Cancelled' && resource.data.status != 'Completed')
            || (request.resource.data.status == 'Pending' && resource.data.status == 'Cancelled')))
        );
      allow delete: if isAdmin();
    }

    // In-app voice calls: only the caller and the person called can see or change a call
    match /calls/{callId} {
      function isCallParty() {
        return request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId;
      }
      allow get, list: if isSignedIn() && isCallParty();
      allow create: if isVerifiedUser()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.calleeId]
        && request.resource.data.status == 'ringing';
      allow update: if isSignedIn() && isCallParty()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAtISO', 'endedAtISO'])
        && request.resource.data.status in ['accepted', 'declined', 'ended', 'missed']
        // Only the person called can pick up
        && (request.resource.data.status != 'accepted' || request.auth.uid == resource.data.calleeId);
      // Either person may remove a finished call
      allow delete: if isAdmin()
        || (isSignedIn() && isCallParty() && resource.data.status in ['declined', 'ended', 'missed']);

      // Network details each phone shares to connect the audio
      match /{side}/{candidateId} {
        allow read, create, delete: if isSignedIn()
          && side in ['callerCandidates', 'calleeCandidates']
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }

    // Reviews: one per completed booking, written by that booking's customer; public to read
    match /reviews/{bookingId} {
      allow get, list: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'Completed'
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.artisanId == request.resource.data.artisanId;
      allow delete: if isAdmin();
    }
  }
}
