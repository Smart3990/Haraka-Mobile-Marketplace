rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The permanent system admin (keep in sync with SYSTEM_ADMIN_EMAIL in src/lib/backend.ts)
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'blanc.69458@gmail.com';
    }

    // True when that person has blocked the signed-in user
    function blockedBy(uid) {
      return uid != request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('blockedUserIds', []);
    }

    // Signed in with a confirmed email address (needed to post, message, call, book, review or apply)
    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || isSystemAdmin());
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email);
    }

    // Admins: the system admin, or anyone added in /admins/{email} who has verified that email
    function isAdmin() {
      return isSystemAdmin() || (
        isSignedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true && exists(adminDocPath())
      );
    }

    // Who may add more admins: the system admin, or admins added with that permission
    function canAddAdmins() {
      return isSystemAdmin() || (isAdmin() && get(adminDocPath()).data.canAddAdmins == true);
    }

    // Platform features the system admin handed to an admin (Platform Settings > Admin Permissions)
    function hasPermission(permission) {
      return isSystemAdmin() || (isAdmin() && permission in get(adminDocPath()).data.get('permissions', []));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles. New accounts are regular users ('buyer'); only an admin
    // can change someone's role or verified badge.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Accounts are created only after the email address is confirmed
      allow create: if isOwner(userId) && isValidId(userId) && isVerifiedUser()
        && request.resource.data.role == 'buyer'
        && !('verified' in request.resource.data);
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified'])
      );
      // Users can delete their own account
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Admins added through the app, keyed by lowercase email. The system admin is never stored here.
    match /admins/{email} {
      allow get: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create, update: if canAddAdmins()
        && email != 'blanc.69458@gmail.com'
        && request.resource.data.email == email
        && request.resource.data.addedBy == request.auth.token.email
        && request.resource.data.canAddAdmins is bool
        // Only the system admin hands out platform permissions
        && (isSystemAdmin() || request.resource.data.get('permissions', []) == (resource == null ? [] : resource.data.get('permissions', [])));
      // The system admin chooses what each admin may do
      allow update: if isSystemAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'canAddAdmins'])
        && request.resource.data.get('permissions', []) is list && request.resource.data.get('permissions', []).size() <= 10
        && request.resource.data.canAddAdmins is bool;
      allow delete: if canAddAdmins();
    }

    // App branding (app bar logo, Welcome page picture, theme colours): everyone reads it; the system admin (or an admin given access) changes it
    function isThemeColor(field) {
      return request.resource.data.get(field, '#000000') is string
        && request.resource.data.get(field, '#000000').matches('^#[0-9A-Fa-f]{6}$');
    }
    match /settings/branding {
      allow get: if true;
      allow create, update: if hasPermission('branding')
        && request.resource.data.keys().hasOnly(['logoUrl', 'welcomeImageUrl', 'primaryColor', 'deepColor', 'accentColor',
          'inkColor', 'backgroundColor', 'updatedAtISO', 'updatedBy'])
        && request.resource.data.get('logoUrl', '') is string && request.resource.data.get('logoUrl', '').size() < 600000
        && request.resource.data.get('welcomeImageUrl', '') is string && request.resource.data.get('welcomeImageUrl', '').size() < 600000
        && isThemeColor('primaryColor') && isThemeColor('deepColor') && isThemeColor('accentColor')
        && isThemeColor('inkColor') && isThemeColor('backgroundColor');
    }

    // Admins whose phones are told about new applications and verification requests.
    // Admins add themselves; anyone can take only themselves off; signed-in users read it to notify them.
    match /settings/adminPush {
      allow get: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids == [request.auth.uid];
      allow update: if isSignedIn() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 50
        && (
          (isAdmin() && request.resource.data.uids.toSet().difference(resource.data.uids.toSet()).hasOnly([request.auth.uid])
            && resource.data.uids.toSet().difference(request.resource.data.uids.toSet()).size() == 0)
          || (request.resource.data.uids.toSet().difference(resource.data.uids.toSet()).size() == 0
            && resource.data.uids.toSet().difference(request.resource.data.uids.toSet()).hasOnly([request.auth.uid]))
        );
    }

    // Marketplace categories changed or added by the system admin (or an admin given access); everyone reads them
    match /categories/{slug} {
      allow get, list: if true;
      allow create, update: if hasPermission('categories') && isValidId(slug)
        && request.resource.data.slug == slug
        && request.resource.data.keys().hasOnly(['slug', 'name', 'image', 'subcategories', 'custom', 'order', 'hidden', 'updatedAtISO'])
        && request.resource.data.get('hidden', false) is bool
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() < 200000
        && request.resource.data.get('name', 'x') is string && request.resource.data.get('name', 'x').size() <= 40
        && request.resource.data.get('subcategories', []) is list && request.resource.data.get('subcategories', []).size() <= 20;
      allow delete: if hasPermission('categories');
    }

    // Home banners added (or built-in ones hidden) in Platform Settings; everyone reads them
    match /banners/{bannerId} {
      allow get, list: if true;
      allow create, update: if hasPermission('banners') && isValidId(bannerId)
        && request.resource.data.id == bannerId
        && request.resource.data.keys().hasOnly(['id', 'builtIn', 'hidden', 'title', 'desc', 'btnText', 'target', 'bg', 'image', 'audience', 'order', 'updatedAtISO'])
        && request.resource.data.get('hidden', false) is bool
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60
        && request.resource.data.get('desc', '') is string && request.resource.data.get('desc', '').size() <= 140
        && request.resource.data.get('btnText', '') is string && request.resource.data.get('btnText', '').size() <= 24
        && request.resource.data.get('target', '') is string && request.resource.data.get('target', '').size() <= 80
        && request.resource.data.get('bg', '') is string && request.resource.data.get('bg', '').size() <= 120
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() < 300000
        && request.resource.data.get('audience', 'everyone') in ['everyone', 'buyer', 'seller', 'artisan', 'applicant', 'admin']
        && request.resource.data.get('order', 0) is number;
      allow delete: if hasPermission('banners');
    }

    // Why something failed on a user's phone (error text and device type), read only by admins
    match /clientErrors/{errorId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'where', 'code', 'message', 'userAgent', 'atISO'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300;
      allow read, delete: if isAdmin();
    }

    // Partner applications (become a seller or artisan), one per user.
    // The applicant can submit or re-submit while it is pending; only an admin decides.
    match /applications/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Only the system admin files an application on someone's behalf (Platform Settings > All Users)
      allow create: if (isSystemAdmin() && request.resource.data.uid == userId) || (
        isOwner(userId) && isVerifiedUser()
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedBadge == false
      );
      allow update: if isAdmin() || (
        isOwner(userId) && isVerifiedUser()
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedBadge == false
      );
      // An approved partner sends ID documents to ask for the Verified badge (only an admin grants it)
      allow update: if isOwner(userId) && isVerifiedUser()
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ghanaCardId', 'frontPhoto', 'backPhoto', 'idVerificationSkipped',
          'verificationRequestStatus', 'verificationRequestedAtISO', 'verificationDeclineReason'])
        && request.resource.data.verificationRequestStatus == 'pending'
        && request.resource.data.idVerificationSkipped == false
        && request.resource.data.ghanaCardId is string && request.resource.data.ghanaCardId.size() >= 10;
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Marketplace listings: anyone can browse; only approved sellers/artisans post
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isVerifiedUser() && isValidId(listingId)
        && request.resource.data.sellerId == request.auth.uid
        && userRole() in ['seller', 'artisan'];
      // The seller edits their own ad; the system admin (or an admin given access) can correct someone
      // else's ad, and admins with category access can move ads to another category
      allow update: if isSignedIn() && isValidId(listingId) && (
        (resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid)
        || (hasPermission('editAds') && request.resource.data.sellerId == resource.data.sellerId)
        || (hasPermission('categories')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'categoryName', 'subcategory']))
        // An admin verifying (or un-verifying) a seller updates the Verified tag on their ads
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVerifiedDeal', 'seller'])
          && request.resource.data.seller.diff(resource.data.seller).affectedKeys().hasOnly(['isVerified']))
      );
      allow delete: if isSignedIn() && isValidId(listingId) && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // Push tokens: any signed-in user may look one up to notify that person; only the owner sets it
    match /pushTokens/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['token', 'updatedAtISO'])
        && request.resource.data.token is string && request.resource.data.token.size() < 200;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Chats: one per buyer per ad, readable and writable only by the buyer and the ad's seller
    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isVerifiedUser() && isValidId(chatId)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.sellerId]
        && chatId == request.resource.data.listingId + '__' + request.auth.uid
        && (
          // About an artisan's services ...
          (request.resource.data.listingId == 'artisan-' + request.resource.data.sellerId
            && exists(/databases/$(database)/documents/artisans/$(request.resource.data.sellerId)))
          // ... or about an ad, with its real seller
          || get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId == request.resource.data.sellerId
        );
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAtISO', 'lastSenderId', 'unread', 'deletedAt'])
        // Each person can only set their own "deleted the chat" time
        && (!('deletedAt' in request.resource.data)
          || request.resource.data.deletedAt.diff(resource.data.get('deletedAt', {})).affectedKeys().hasOnly([request.auth.uid]));

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in chatParticipants();
        allow create: if isVerifiedUser() && request.auth.uid in chatParticipants()
          && request.resource.data.senderId == request.auth.uid
          // Nobody can message a person who blocked them
          && !blockedBy(chatParticipants()[0]) && !blockedBy(chatParticipants()[1]);
        // Only the person who received an offer can accept it; anyone in the chat can hide a message for themselves
        allow update: if isSignedIn() && request.auth.uid in chatParticipants() && (
          (resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus'])
            && request.resource.data.offerStatus == 'accepted')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
            && request.resource.data.hiddenFor.toSet() == resource.data.get('hiddenFor', []).toSet().union([request.auth.uid].toSet()))
        );
        // The sender can delete their own message for everyone
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid && request.auth.uid in chatParticipants();
      }
    }

    // "Report this listing": any signed-in user can send one; only admins read and handle them
    match /reports/{reportId} {
      allow create: if isVerifiedUser() && isValidId(reportId)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow get, list, update, delete: if isAdmin();
    }

    // Public artisan profiles, created by an admin when an artisan application is approved
    match /artisans/{artisanId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() || isOwner(artisanId);
      allow update: if isAdmin()
        // The artisan edits their own public details
        || (isOwner(artisanId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['available', 'inspectionFee', 'bio', 'phone', 'whatsapp', 'avatar', 'responseTime']))
        // Completing a booking adds exactly one job, once per booking
        || (isOwner(artisanId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobsCompleted', 'lastCompletedBookingId'])
          && request.resource.data.jobsCompleted == resource.data.jobsCompleted + 1
          && request.resource.data.lastCompletedBookingId != resource.data.lastCompletedBookingId
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.status != 'Completed'
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.status == 'Completed'
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastCompletedBookingId)).data.artisanId == artisanId);
    }

    // Artisan bookings: visible to the customer, the artisan and admins only
    match /bookings/{bookingId} {
      function isBookingParty() {
        return isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.artisanId == request.auth.uid ||
          isAdmin()
        );
      }
      allow get, list: if isBookingParty();
      allow create: if isVerifiedUser() && isValidId(bookingId)
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.artisanId != request.auth.uid
        && request.resource.data.status == 'Pending'
        && exists(/databases/$(database)/documents/artisans/$(request.resource.data.artisanId));
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtISO'])
        && (
          isAdmin()
          // The artisan accepts, declines, starts and completes
          || (resource.data.artisanId == request.auth.uid
            && request.resource.data.status in ['Confirmed', 'In Progress', 'Completed', 'Declined'])
          // The customer cancels (unless done) or asks again after cancelling
          || (resource.data.customerId == request.auth.uid && (
            (request.resource.data.status == 'Cancelled' && resource.data.status != 'Completed')
            || (request.resource.data.status == 'Pending' && resource.data.status == 'Cancelled')))
        );
      allow delete: if isAdmin();
    }

    // In-app voice calls: only the caller and the person called can see or change a call
    match /calls/{callId} {
      function isCallParty() {
        return request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId;
      }
      allow get, list: if isSignedIn() && isCallParty();
      allow create: if isVerifiedUser()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.calleeId]
        && request.resource.data.status == 'ringing'
        && !blockedBy(request.resource.data.calleeId);
      allow update: if isSignedIn() && isCallParty()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAtISO', 'endedAtISO'])
        && request.resource.data.status in ['accepted', 'declined', 'ended', 'missed']
        // Only the person called can pick up
        && (request.resource.data.status != 'accepted' || request.auth.uid == resource.data.calleeId);
      // Either person may remove a finished call
      allow delete: if isAdmin()
        || (isSignedIn() && isCallParty() && resource.data.status in ['declined', 'ended', 'missed']);

      // Network details each phone shares to connect the audio
      match /{side}/{candidateId} {
        allow read, create, delete: if isSignedIn()
          && side in ['callerCandidates', 'calleeCandidates']
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }

    // Reviews: one per completed booking, written by that booking's customer; public to read
    match /reviews/{bookingId} {
      allow get, list: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'Completed'
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.artisanId == request.resource.data.artisanId;
      allow delete: if isAdmin();
    }
  }
}
