rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kiyumartofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Marketplace Listings
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(listingId);
      allow update: if isSignedIn() && isValidId(listingId) && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(listingId) && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // Artisan Bookings
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (
        resource.data.customerId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(bookingId);
      allow update: if isSignedIn() && isValidId(bookingId) && (
        resource.data.customerId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
